# Copy this file to .env and fill in your values.
# NEVER commit .env — it is gitignored.
# .env.example is safe to commit because it contains no real secrets.

# ── App ───────────────────────────────────────────────────────────────────────

# URL of the running Next.js frontend (used for CORS)
CLIENT_URL=http://localhost:3000

# 64-char hex string used to derive per-user encryption keys.
# Generate one: python -c "import secrets; print(secrets.token_hex(32))"
MASTER_KEY=replace_with_64_char_hex_string

# ── Supabase ──────────────────────────────────────────────────────────────────
# Dashboard → Settings → API

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# ── Market data ───────────────────────────────────────────────────────────────
# Polygon: https://polygon.io  (free tier works)
# Finnhub: https://finnhub.io  (free tier works)

POLYGON_API_KEY=
FINNHUB_API_KEY=

# ── AI ────────────────────────────────────────────────────────────────────────
# Google AI Studio: https://aistudio.google.com/apikey

GEMINI_API_KEY=

# Optional overrides — defaults are rolling aliases that Google keeps pointed at
# a current model. Only set these if Google deprecates the aliases themselves.
# GEMINI_MODEL=gemini-flash-latest
# GEMINI_MODEL_LITE=gemini-flash-lite-latest

# ── News & email ──────────────────────────────────────────────────────────────
# NewsAPI: https://newsapi.org  (free tier works)
# Resend:  https://resend.com   (required for price alert emails)

NEWSAPI_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=alerts@yourdomain.com

# ── Workers ───────────────────────────────────────────────────────────────────
# Random secret used to authenticate the cron job hitting /api/worker
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
CRON_SECRET=replace_with_random_secret
